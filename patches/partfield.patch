diff --git a/run_part_clustering_with_glb.py b/run_part_clustering_with_glb.py
new file mode 100644
index 0000000..1725fa2
--- /dev/null
+++ b/run_part_clustering_with_glb.py
@@ -0,0 +1,68 @@
+"""GLB-compatible helpers for PartField mesh clustering.
+
+This module provides the pieces that ``simfoundry/segment_mesh_partfield.py`` relies
+on:
+
+* ``construct_face_adjacency_matrix_facemst`` -- re-exported from the upstream
+  ``run_part_clustering`` module so callers have a single import location.
+* ``export_colored_mesh_glb`` -- a GLB equivalent of the upstream
+  ``export_colored_mesh_ply`` that writes per-face segmentation colors into a
+  binary glTF (``.glb``) file.
+"""
+
+import numpy as np
+import trimesh
+import matplotlib.pyplot as plt
+
+# Re-export the adjacency builder so downstream code can import everything it
+# needs from this single module.
+from run_part_clustering import construct_face_adjacency_matrix_facemst  # noqa: F401
+
+__all__ = [
+    "construct_face_adjacency_matrix_facemst",
+    "export_colored_mesh_glb",
+]
+
+
+def export_colored_mesh_glb(V, F, FL, filename="segmented_mesh.glb"):
+    """Export a mesh with per-face segmentation labels into a colored GLB file.
+
+    Parameters
+    ----------
+    V : np.ndarray
+        Vertices array of shape ``(N, 3)``.
+    F : np.ndarray
+        Faces array of shape ``(M, 3)``.
+    FL : np.ndarray
+        Per-face labels of shape ``(M,)``.
+    filename : str
+        Output filename. A ``.glb`` extension produces a binary glTF file.
+    """
+    V = np.asarray(V)
+    F = np.asarray(F)
+    FL = np.squeeze(np.asarray(FL))
+
+    assert V.shape[1] == 3, "Vertices must have shape (N, 3)"
+    assert F.shape[1] == 3, "Faces must have shape (M, 3)"
+    assert F.shape[0] == FL.shape[0], "There must be exactly one label per face"
+
+    # Generate distinct colors for each unique label.
+    unique_labels = np.unique(FL)
+    colormap = plt.cm.get_cmap("tab20", max(len(unique_labels), 1))
+    label_to_color = {
+        label: (np.array(colormap(i)[:3]) * 255).astype(np.uint8)
+        for i, label in enumerate(unique_labels)
+    }
+
+    # Build an (M, 4) RGBA face-color array (vectorized for speed on large meshes).
+    face_colors = np.empty((F.shape[0], 4), dtype=np.uint8)
+    face_colors[:, 3] = 255
+    for label, color in label_to_color.items():
+        face_colors[FL == label, :3] = color
+
+    mesh = trimesh.Trimesh(vertices=V, faces=F, process=False)
+    mesh.visual.face_colors = face_colors
+
+    mesh.export(filename)
+    print(f"Exported mesh to {filename}")
+    return mesh
