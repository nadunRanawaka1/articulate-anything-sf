+    @staticmethod
+    def encode_PIL_image(image: PIL.Image.Image) -> str:
+        buffered = BytesIO()
+        image.save(buffered, format="PNG")
+        img_str = base64.b64encode(buffered.getvalue()).decode('utf-8')
+        return img_str
